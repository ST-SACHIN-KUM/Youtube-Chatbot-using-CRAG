{
  "manifest_version": 3,
  "name": "YouTube Chatbot",
  "version": "1.0",
  "description": "Ask questions about the current YouTube video using your RAG chatbot.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Chatbot"
  },
  "background": {
    "service_worker": "background.js"
  }
}